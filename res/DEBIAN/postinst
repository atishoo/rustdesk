#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/capylink/capylink /usr/bin/capylink

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/capylink.service ]; then
			rm -f /etc/systemd/system/capylink.service /usr/lib/systemd/system/capylink.service /usr/lib/systemd/user/capylink.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/capylink/files/systemd/capylink.service /usr/lib/systemd/system/capylink.service
		# try fix error in Ubuntu 18.04
		# Failed to reload capylink.service: Unit capylink.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/capylink.service:10: Executable path is not absolute: pkill -f "capylink --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/capylink.service
		fi
		systemctl daemon-reload
		systemctl enable capylink
		systemctl start capylink
	fi
fi
